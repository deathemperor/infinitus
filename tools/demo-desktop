#!/usr/bin/env python3
"""Demo Infinitus desktop (#822): the slice of the desktop app's HTTP
server the CLI's environments/projects/threads/thread verbs read and
write — descriptor, shell snapshot, one thread's detail, holds, dispatch
(turn start with an optional create-thread bootstrap, interrupt) and
release-thread — with a fabricated project and two threads. Every
request must carry the bearer token in argv; anything else is 401.
No real data; e2e only.  usage: demo-desktop <port> <token>"""
import json, sys, uuid, datetime
from http.server import BaseHTTPRequestHandler, HTTPServer

PORT, TOKEN = int(sys.argv[1]), sys.argv[2]

def now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.000Z")

PROJECT = {"id": "p-demo", "title": "Demo project", "workspaceRoot": "/tmp/demo-project",
           "defaultModelSelection": {"provider": "claude", "model": "opus"}, "scripts": [],
           "createdAt": now(), "updatedAt": now()}
THREADS = {
    "t-running": {"id": "t-running", "projectId": "p-demo", "title": "Running one", "runtimeMode": "full-access",
                  "interactionMode": "default", "branch": None, "worktreePath": None, "archivedAt": None,
                  "latestTurn": {"turnId": "u-1", "state": "running", "assistantMessageId": None},
                  "session": {"threadId": "t-running", "status": "running", "activeTurnId": "u-1"},
                  "updatedAt": "2026-09-12T00:00:02.000Z", "hasPendingApprovals": False, "hasPendingUserInput": False},
    "t-idle": {"id": "t-idle", "projectId": "p-demo", "title": "Idle one", "runtimeMode": "approval-required",
               "interactionMode": "default", "branch": None, "worktreePath": None, "archivedAt": None,
               "latestTurn": {"turnId": "u-2", "state": "completed", "assistantMessageId": "m-2"},
               "session": None, "updatedAt": "2026-09-12T00:00:01.000Z", "hasPendingApprovals": False, "hasPendingUserInput": False},
}
MESSAGES = {"t-running": [{"id": "m-1", "role": "user", "text": "keep going", "turnId": "u-1", "streaming": False, "createdAt": now()}],
            "t-idle": [{"id": "m-0", "role": "user", "text": "hello", "turnId": "u-2", "streaming": False, "createdAt": now()},
                       {"id": "m-2", "role": "assistant", "text": "hi there", "turnId": "u-2", "streaming": False, "createdAt": now()}]}
HOLDS = [{"threadId": "t-idle", "since": now(), "summary": "at limit until 09:00", "kind": "held"}]
DISPATCHES = []   # every command received, for the e2e's assertions
SEQ = [0]

class H(BaseHTTPRequestHandler):
    def log_message(self, *a): pass

    def reply(self, status, body):
        data = json.dumps(body).encode()
        self.send_response(status); self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data))); self.end_headers(); self.wfile.write(data)

    def authed(self):
        if self.headers.get("Authorization") == "Bearer " + TOKEN: return True
        self.reply(401, {"error": "Unauthorized"}); return False

    def do_GET(self):
        path = self.path.split("?")[0]
        if path == "/.well-known/t3/environment":
            return self.reply(200, {"environmentId": "env-demo", "label": "Demo desktop", "platform": "darwin",
                                    "serverVersion": "0.0.0-demo", "capabilities": []})
        if path == "/api/auth/session":   # answers everyone, like the desktop's
            ok = self.headers.get("Authorization") == "Bearer " + TOKEN
            return self.reply(200, {"authenticated": ok, "auth": {"mode": "token"}})
        if not self.authed(): return
        if path == "/api/orchestration/shell":
            return self.reply(200, {"snapshotSequence": SEQ[0], "projects": [PROJECT], "threads": list(THREADS.values()), "updatedAt": now()})
        if path.startswith("/api/orchestration/threads/"):
            tid = path.rsplit("/", 1)[1]
            if tid not in THREADS: return self.reply(404, {"error": "no thread " + tid})
            return self.reply(200, dict(THREADS[tid], messages=MESSAGES.get(tid, []), activities=[], proposedPlans=[], checkpoints=[]))
        if path == "/api/infinitus/holds":
            return self.reply(200, HOLDS)
        if path == "/api/demo/dispatches":
            return self.reply(200, DISPATCHES)
        self.reply(404, {"error": "no route " + path})

    def do_POST(self):
        if not self.authed(): return
        body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or b"{}")
        SEQ[0] += 1
        if self.path == "/api/orchestration/dispatch":
            DISPATCHES.append(body)
            kind, tid = body.get("type"), body.get("threadId")
            if kind == "thread.turn.start":
                create = (body.get("bootstrap") or {}).get("createThread")
                if create:
                    THREADS[tid] = {"id": tid, "projectId": create["projectId"], "title": create["title"],
                                    "runtimeMode": create["runtimeMode"], "interactionMode": create["interactionMode"],
                                    "branch": create.get("branch"), "worktreePath": "/tmp/demo-project/.wt/" + tid if create.get("branch") else None,
                                    "archivedAt": None, "latestTurn": None, "session": None, "updatedAt": now(),
                                    "hasPendingApprovals": False, "hasPendingUserInput": False}
                    MESSAGES[tid] = []
                if tid not in THREADS: return self.reply(400, {"error": "no thread " + tid})
                t = THREADS[tid]; msg = body["message"]
                turn = "u-" + uuid.uuid4().hex[:6]
                if t["latestTurn"] and t["latestTurn"]["state"] == "running":
                    turn = t["latestTurn"]["turnId"]   # a steer folds into the running turn
                    MESSAGES[tid].append({"id": msg["messageId"], "role": "user", "text": msg["text"], "turnId": turn, "streaming": False, "createdAt": now()})
                    return self.reply(200, {"sequence": SEQ[0]})
                answer = "m-" + uuid.uuid4().hex[:6]
                MESSAGES[tid] += [{"id": msg["messageId"], "role": "user", "text": msg["text"], "turnId": turn, "streaming": False, "createdAt": now()},
                                  {"id": answer, "role": "assistant", "text": "echo: " + msg["text"], "turnId": turn, "streaming": False, "createdAt": now()}]
                t["latestTurn"] = {"turnId": turn, "state": "completed", "assistantMessageId": answer}
                t["updatedAt"] = now()
                return self.reply(200, {"sequence": SEQ[0]})
            if kind == "thread.turn.interrupt":
                t = THREADS.get(tid)
                if t and t["latestTurn"] and t["latestTurn"]["state"] == "running":
                    t["latestTurn"]["state"] = "interrupted"; t["session"] = {"threadId": tid, "status": "interrupted", "activeTurnId": None}
                return self.reply(200, {"sequence": SEQ[0]})
            return self.reply(400, {"error": "unknown command " + str(kind)})
        if self.path == "/api/infinitus/release-thread":
            tid = body.get("threadId")
            before = len(HOLDS); HOLDS[:] = [h for h in HOLDS if h["threadId"] != tid]
            return self.reply(200, {"released": len(HOLDS) < before} if len(HOLDS) < before else {"released": False, "reason": "not held"})
        self.reply(404, {"error": "no route " + self.path})

HTTPServer(("127.0.0.1", PORT), H).serve_forever()
