#!/bin/bash
# playctl — drive the Infinitus playground from the shell (dev tool).
# The playground polls $TMPDIR/infinitus-cmd every 0.25s and answers in
# infinitus-cmd-out; `shot` captures the Playground window by CGWindowID
# (never a screen region). Usage:
#   playctl theme rpg | layout wide|stacked|hstack | size default|large|xlarge|huge
#   playctl compact on|off | burn off|ember|flame|limit | introstyle top|...|off
#   playctl title zoom|slam|spin|off | speed 1.5 | intro | switch | dead | revive
#   playctl drop 5h|7d|fable | undrop 5h|7d|fable | kill | refresh | reset | themes
#   playctl scenario off|empty|alldead|solo|duo|noengine | fleets 2
#   playctl shot /path/out.png
set -euo pipefail
T="${TMPDIR:-/tmp}"
if [ "${1:-}" = "shot" ]; then
    # Window-id lookup: a tiny cached swiftc helper (system python3
    # has no Quartz). Built on first use next to this script.
    helper="$(dirname "$0")/.winid"
    if [ ! -x "$helper" ]; then
        cat > "$T/winid.swift" <<'SWIFT'
import CoreGraphics
let name = CommandLine.arguments.count > 1 ? CommandLine.arguments[1] : "Playground"
let list = CGWindowListCopyWindowInfo([.optionAll], kCGNullWindowID) as? [[String: Any]] ?? []
for w in list where (w["kCGWindowName"] as? String) == name {
    print(w["kCGWindowNumber"] as! Int); break
}
SWIFT
        swiftc -O -o "$helper" "$T/winid.swift"
    fi
    wid=$("$helper" Playground)
    [ -n "$wid" ] || { echo "no Playground window" >&2; exit 1; }
    screencapture -x -o -l"$wid" "$2"
    echo "$2"
    exit 0
fi
rm -f "$T/infinitus-cmd-out"
echo "$*" > "$T/infinitus-cmd"
for _ in $(seq 40); do
    if [ -f "$T/infinitus-cmd-out" ]; then cat "$T/infinitus-cmd-out"; exit 0; fi
    sleep 0.1
done
echo "timeout: playground not listening?" >&2
exit 1
