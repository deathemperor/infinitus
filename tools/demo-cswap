                                   "infinitus-demo-dead"))
# Killing blow: alpha's 5h jumps to 100% — a 63-point drop that KILLS,
# playing the drop drama plus the shard-burst finisher and death beat.
KILL = os.path.exists(os.path.join(os.environ.get("TMPDIR", "/tmp"),
                                   "infinitus-demo-kill"))
# Playground drop buttons (user 2026-08-31 "play drop (5h,7d,fable)"):
# each flag pins ONE of alpha's windows +35 points used — flag on plays
# the drop drama on that bar, flag off plays the spring refill.
DROP5 = os.path.exists(os.path.join(os.environ.get("TMPDIR", "/tmp"),
                                    "infinitus-demo-drop5h"))
DROP7 = os.path.exists(os.path.join(os.environ.get("TMPDIR", "/tmp"),
                                    "infinitus-demo-drop7d"))
DROPF = os.path.exists(os.path.join(os.environ.get("TMPDIR", "/tmp"),
                                    "infinitus-demo-dropfable"))

def state():
    try:
        return json.load(open(STATE))
    except Exception:
        return {"active": 1}

def save(st): json.dump(st, open(STATE, "w"))

def iso(hours):
    t = datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(hours=hours)
    return t.isoformat()

def win(pct, hours, countdown, clock, expected=None, ahead=False, scoped_name=None):
    d = {"pct": pct, "resetsAt": iso(hours), "countdown": countdown, "clock": clock}
    if expected is not None:
        d.update({"expectedPct": expected, "aheadOfPace": ahead,
                  "projectedExhaustionAt": iso(hours*2), "willLastToReset": not ahead})
    if scoped_name: d["name"] = scoped_name
    return d

def account(num, alias, plan, five, seven, scoped, spend_used, active,
            status="ok", disabled=False):
    a = {
        "number": num, "email": f"{alias}@example.com",
        "organizationName": f"{alias}@example.com's Organization",
        "organizationUuid": f"00000000-0000-0000-0000-0000000000{num:02d}",
        "isOrganization": True, "active": active, "usageStatus": status,
        "usage": None if status != "ok" else
                 {"fiveHour": five, "sevenDay": seven,
                  "spend": {"used": spend_used, "limit": 200.0,
                            "pct": round(spend_used/2.0, 1), "currency": "USD"},
                  "scoped": scoped},
        "alias": alias, "plan": plan,
        "usageFetchedAt": iso(0), "usageAgeSeconds": 30.0,
    }
    if disabled: a["disabled"] = True
    return a

