def sessions():
    now = int(time.time()*1000)
    rows = [("busy", "/Users/demo/projects/api"), ("busy", "/Users/demo/projects/web"),
            ("busy", "/Users/demo/projects/cli"), ("idle", "/Users/demo/projects/docs"),
            ("idle", "/Users/demo/projects/infra"), ("idle", "/Users/demo/notes"),
            ("idle", "/Users/demo/projects/blog"), ("idle", "/Users/demo/scratch")]
    out = [{"pid": 1000+i, "cwd": c, "status": s,
            "kind": "interactive", "startedAt": now - i*900000}
           for i, (s, c) in enumerate(rows)]
    # A session with a REAL pid (the e2e gate's fake Claude session): the
    # app drops the 1000+i rows as dead before it reads their transcripts.
    if os.environ.get("DEMO_SESSION_PID"):
        out.append({"pid": int(os.environ["DEMO_SESSION_PID"]),
                    "cwd": os.environ.get("DEMO_SESSION_CWD", "/Users/demo/projects/e2e"),
                    "status": "idle", "kind": "interactive", "startedAt": now - 60000})
    return {"busy": 3, "idle": len(out) - 3, "waiting": 0, "shell": 0, "unknown": 0,
            "total": len(out), "sessions": out}

def ordered(rows, st):
    order = st.get("order") or []
    rank = {n: i for i, n in enumerate(order)}
    return sorted(rows, key=lambda r: rank.get(r["number"], len(order) + r["number"]))

args = sys.argv[1:]
cmd = args[0] if args else ""

if cmd == "--version":
    print("cswap 0.26.0")
elif cmd == "simulate":
    # Playground scenario staging (issue #6): `simulate empty|alldead|off`
    # persists in the state file so every later `list` plays the scene —
    # unlike the SHIM_* env vars, this works on a RUNNING app.
    st = state()
    mode = args[1] if len(args) > 1 else "off"
    if mode == "off":
        st.pop("scenario", None)
    else:
        st["scenario"] = mode
    save(st)
    print(json.dumps({"ok": True, "scenario": st.get("scenario")}))
elif cmd == "list":
    st = state()
    # Onboarding simulation: an engine that manages nothing yet.
    if st.get("scenario") == "empty" or os.environ.get("DEMO_EMPTY"):
        print(json.dumps({"schemaVersion": 1, "activeAccountNumber": None,
                          "nextCandidate": None, "liveSessions": None,
                          "accounts": []}))
        sys.exit(0)
    accounts = ordered(fleet(st["active"]), st)
    # Dynamic rotation holds (disable/enable verbs); hotel stays the
    # static example unless explicitly enabled.
    for a in accounts:
        n = a["number"]
        if n in st.get("disabled", []):
            a["disabled"] = True
        elif n in st.get("enabled", []):
            a.pop("disabled", None)
        if str(n) in st.get("aliases", {}):
            a["alias"] = st["aliases"][str(n)]
    payload = {"schemaVersion": 1, "activeAccountNumber": st["active"],
               "nextCandidate": 4 if st["active"] != 4 else 1,
               "liveSessions": sessions(), "accounts": accounts}
    # The mainline fleets (user 2026-09-03 "invest efforts for users
    # with 1 & 2 accounts"): `simulate solo` keeps the active account
    # alone (nothing to rotate to), `simulate duo` keeps it plus one.
    if st.get("scenario") in ("solo", "duo"):
        keep = 1 if st["scenario"] == "solo" else 2
        accounts = [a for a in accounts if a["number"] == st["active"]] \
            + [a for a in accounts if a["number"] != st["active"]][:keep - 1]
        payload["accounts"] = accounts
        payload["nextCandidate"] = accounts[1]["number"] if keep == 2 else None
    if st.get("scenario") == "alldead" or os.environ.get("SHIM_ALLDEAD"):
        # Every window maxed: no viable candidate, echo recovers first.
        for a in accounts:
            if not a["usage"]:
                continue
            for w in [a["usage"]["fiveHour"], a["usage"]["sevenDay"]] + a["usage"]["scoped"]:
                w["pct"] = 100.0
        payload["nextCandidate"] = None
        payload["nextRecovery"] = {"number": 5, "at": iso(0.9)}
    print(json.dumps(payload))
elif cmd in ("disable", "enable"):
    st = state()
    nums = [int(a) for a in args[1:] if a.isdigit()]
    dis = set(st.get("disabled", [])); en = set(st.get("enabled", []))
    for n in nums:
        if cmd == "disable": dis.add(n); en.discard(n)
        else: en.add(n); dis.discard(n)
    st["disabled"] = sorted(dis); st["enabled"] = sorted(en)
    save(st)
    print(f"{cmd}d: {nums}")
elif cmd == "alias":
    # `alias <n> <name>` / `alias <n> --unset` — same verb shape as cswap.
    st = state()
    aliases = st.setdefault("aliases", {})
    if "--unset" in args[2:]:
        aliases.pop(args[1], None)
    else:
        aliases[args[1]] = " ".join(args[2:])
    save(st)
    print(json.dumps({"schemaVersion": 1, "aliases": aliases}))
elif cmd == "reset":
    # Back to the pristine fleet: tools/e2e.sh runs this before and after
    # so a run never inherits (or leaves) staged state. The state file is
    # per $TMPDIR, i.e. shared with the dev Mac's playground — an e2e run
    # resets a staged playground scenario too.
    try:
        os.remove(STATE)
    except FileNotFoundError:
        pass
    print(json.dumps({"ok": True}))
elif cmd == "reorder":
    st = state()
    st["order"] = [int(a) for a in args[1:] if a.isdigit()]
    save(st)
    print(json.dumps({"schemaVersion": 1, "order": st["order"]}))
elif cmd == "run":
    # The igniter (`cswap run <n> -- -p . --max-turns 1`): a real cswap
    # execs claude here; the demo just answers.
    print("Launching Account-%s [session mode]" % (args[1] if len(args) > 1 else "?"))
elif cmd == "switch":
    st = state()
    nums = [a for a in args[1:] if a.isdigit()]
    st["active"] = int(nums[0]) if nums else (4 if st["active"] != 4 else 1)
    save(st)
    print(json.dumps({"schemaVersion": 1, "switchedTo": st["active"]}))
elif cmd == "usage":
    accts = [(1, "alpha", 74.31, 812), (2, "bravo", 41.02, 465),
             (3, "charlie", 18.77, 240), (4, "delta", 6.40, 91), (5, "echo", 52.13, 530),
             (6, "foxtrot", 33.60, 371), (8, "hotel", 9.85, 118), (9, "india", 61.44, 640)]
    print(json.dumps({"schemaVersion": 1, "days": 7,
        "estimatedTotalUSD": round(sum(a[2] for a in accts), 2),
        "priceTable": {"source": "models.dev", "date": "2026-08-28"},
        # `UsageReport.caveats` is required (the real CLI always sends it).
        "caveats": ["Estimates at API list price from token counts; not a bill."],
        "accounts": [{"number": n, "email": f"{al}@example.com", "alias": al,
                      "estimatedUSD": usd, "messages": msg, "input": msg*300,
                      "output": msg*2200, "cacheRead": msg*140000, "cacheWrite": msg*9000,
                      "models": [{"model": "claude-fable-5", "estimatedUSD": round(usd*0.6, 2), "messages": msg//2},
                                 {"model": "claude-sonnet-5", "estimatedUSD": round(usd*0.4, 2), "messages": msg - msg//2}]}
                     for n, al, usd, msg in accts]}))
elif cmd == "config":
    # list/set/unset; only autoswitch.preferred persists (the app's star).
    st = state()
    sub = args[1] if len(args) > 1 else "list"
    if sub == "set" and len(args) > 3:
        st.setdefault("config", {})[args[2]] = args[3]; save(st)
        print(json.dumps({"ok": True, "key": args[2], "value": args[3]}))
    elif sub == "unset" and len(args) > 2:
        st.get("config", {}).pop(args[2], None); save(st)
        print(json.dumps({"ok": True, "key": args[2]}))
    else:
        pref = st.get("config", {}).get("autoswitch.preferred")
        print(json.dumps({"schemaVersion": 1, "path": "/Users/demo/.claude-swap-backup/settings.json",
            "settings": [{"key": "autoswitch.enabled", "value": True, "isSet": False,
                          "kind": "bool", "help": "Auto-switching on/off", "default": True},
                         {"key": "autoswitch.threshold", "value": 98.0, "isSet": False,
                          "kind": "float", "help": "Switch when a window hits this pct", "default": 98.0},
                         {"key": "autoswitch.preferred", "value": pref, "isSet": pref is not None,
                          "kind": "string", "help": "Land on these accounts first when switching (emails and/or slot numbers, comma-separated)",
                          "default": None}]}))
elif cmd == "history":
    print(json.dumps({"schemaVersion": 1, "switches": [
        {"from": 5, "to": 1, "at": "2026-08-30 19:41"},
        {"from": 2, "to": 5, "at": "2026-08-30 14:05"},
        {"from": 1, "to": 2, "at": "2026-08-30 09:12"}],
        "logPath": "/Users/demo/.claude-swap-backup/claude-swap.log"}))
elif cmd == "notify":
    print(json.dumps({"schemaVersion": 1, "slackWebhookUrl": None,
                      "telegramBotToken": None, "telegramChatId": None}))
elif cmd == "auto":
    try:
        while True: time.sleep(3600)
    except KeyboardInterrupt:
        pass
else:
    print("{}")
